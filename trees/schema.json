{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "readypath/tree.schema.json",
  "title": "ReadyPath fault isolation tree",
  "description": "One file = one tree. The app also enforces rules JSON Schema can't express (see README: Validator rules).",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "start",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique tree id. Route nodes reference this."
    },
    "title": {
      "type": "string",
      "description": "Shown on the entry screen as the symptom category."
    },
    "role": {
      "enum": [
        "category",
        "triage"
      ],
      "default": "category",
      "description": "'triage' = the 'I'm not sure' tree. Exactly one should exist."
    },
    "version": {
      "type": "string",
      "description": "Bump on every edit. Recorded in every run and handoff."
    },
    "status": {
      "enum": [
        "PLACEHOLDER",
        "DRAFT",
        "VERIFIED"
      ],
      "description": "VERIFIED is only allowed when every node has a real source."
    },
    "sourceDocs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Doc titles/links this tree was built from."
    },
    "tools": {
      "type": "array",
      "items": {
        "enum": [
          "scout",
          "tapp"
        ]
      },
      "description": "Hide this category unless the operator picked one of these tools. Omit = all."
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "volvo",
          "international",
          "perseus"
        ]
      },
      "description": "Hide this category on other platforms. Omit = all."
    },
    "start": {
      "type": "string",
      "description": "Node id where the run begins."
    },
    "nodes": {
      "type": "object",
      "description": "Map of node id -> node.",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "enum": [
            "scout",
            "tapp"
          ]
        },
        "platform": {
          "enum": [
            "volvo",
            "international",
            "perseus"
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "description": "Overrides text/help/steps/caution when 'when' matches. All matching variants apply in order; later wins.",
      "required": [
        "when"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/definitions/when"
        },
        "text": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caution": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "label",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Answer button text."
        },
        "short": {
          "type": "string",
          "description": "Breadcrumb text (keep under ~18 chars)."
        },
        "next": {
          "type": "string",
          "description": "Node id to go to when tapped."
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "scout",
              "tapp"
            ]
          },
          "description": "Only show this answer for these tools."
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "volvo",
              "international",
              "perseus"
            ]
          },
          "description": "Only show this answer on these platforms."
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "question",
            "input",
            "action",
            "terminal",
            "route"
          ]
        },
        "text": {
          "type": "string",
          "description": "Question, instruction headline, or terminal message."
        },
        "short": {
          "type": "string",
          "description": "Breadcrumb label for action nodes."
        },
        "help": {
          "type": "string",
          "description": "Smaller supporting text under the question."
        },
        "source": {
          "type": "string",
          "description": "Where this node came from. 'TS: DTP-\u2026' = drafted from past TS tickets (shown with a draft banner). Missing or TODO/PLACEHOLDER = placeholder. Anything else = an SOP/doc reference."
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "scout",
              "tapp"
            ]
          },
          "description": "Node only applies to these tools. Requires skipTo."
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "volvo",
              "international",
              "perseus"
            ]
          },
          "description": "Node only applies on these platforms. Requires skipTo."
        },
        "skipTo": {
          "type": "string",
          "description": "Where to go silently when tools/platforms filter excludes this node."
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/variant"
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/option"
          },
          "description": "question only"
        },
        "authorizedRole": {
          "const": "VO",
          "description": "action only. Must be VO. Anything a VO isn't authorized to do belongs behind ESCALATE_VRE."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "action only. Numbered steps shown to the operator."
        },
        "caution": {
          "type": "string",
          "description": "action only. Shown in a red-edged box."
        },
        "next": {
          "type": "string",
          "description": "action: where to go if not resolved or can't be done. input: where to go after Continue/Skip."
        },
        "resolvedNext": {
          "type": "string",
          "description": "action only, optional. A RESOLVED terminal to use if Yes. Default: built-in resolved screen."
        },
        "terminal": {
          "enum": [
            "RESOLVED",
            "ESCALATE_VRE"
          ],
          "description": "terminal only."
        },
        "tree": {
          "type": "string",
          "description": "route only. Tree id to continue in (used by the triage tree)."
        },
        "handoffNote": {
          "type": "string",
          "description": "terminal only, optional. Added to the VRE handoff as 'FROM PAST TICKETS' \u2014 the likely ask or known causes."
        },
        "placeholder": {
          "type": "string",
          "description": "input only. Hint text inside the text box."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "question"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            }
          },
          "then": {
            "required": [
              "authorizedRole",
              "steps",
              "next"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "required": [
              "terminal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "route"
              }
            }
          },
          "then": {
            "required": [
              "tree"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            }
          },
          "then": {
            "required": [
              "next"
            ]
          }
        }
      ]
    }
  }
}
